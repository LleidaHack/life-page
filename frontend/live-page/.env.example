# LleidaHackBackend base URL (event operations, alerts, push, WebSocket).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://localhost:8000
# For local development against a remote API without localhost CORS access:
# set NEXT_PUBLIC_API_BASE_URL=http://localhost:3000 and
# API_INTERNAL_BASE_URL=https://your-backend.example in .env.development.local.
# The development server proxies /v1 requests to API_INTERNAL_BASE_URL.
NEXT_PUBLIC_TWITCH_PARENT=live.hackeps.com,live.lleida.net
# Optional: pin an event id. Empty = current HackEPS edition (/v1/event/get_hackeps).
NEXT_PUBLIC_EVENT_ID=
# Optional: link to the edition's Devpost page.
NEXT_PUBLIC_DEVPOST_URL=
